---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import '../../styles/home.css';
import { SITE_DESCRIPTION_ES, SITE_TITLE } from '../../consts';
import astronomerBadge from '../../assets/credentials/astronomer.png';
import awsCloudPractitionerBadge from '../../assets/credentials/aws-certified-cloud-practitioner.png';
import databricksAssociateBadge from '../../assets/credentials/databricks-associate.png';
import databricksFundamentalsBadge from '../../assets/credentials/databricks-fundamentals.png';
import databricksProfessionalBadge from '../../assets/credentials/databricks-professional.png';
import dbtBadge from '../../assets/credentials/dbt.png';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION_ES} />
	</head>
	<body class="home-page">
		<Header />
		<main>
			<section class="hero-section">
				<div class="hero-content">
					<div class="hero-left">
						<p class="hero-kicker">Field Engineering Leader · Fundador de Data Wizard</p>
						<h1 class="hero-title">Daniel DataShow</h1>
						<p class="hero-intro">
							Ayudo a empresas y profesionales a sacarle valor a sus datos con Databricks, Spark e IA. Comparto lo que aprendo en charlas, videos y en la comunidad Data Wizard.
						</p>
						<div class="hero-actions">
							<a class="btn-primary btn-linkedin" href="https://www.linkedin.com/in/danielportugalr/" target="_blank" rel="noreferrer"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.475 0 16 .513 16 1.146v13.708c0 .633-.525 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.213c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.213V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/></svg>Conecta en LinkedIn</a>
							<a class="btn-secondary" href="/es/presentaciones">Ver presentaciones</a>
						</div>
						<div class="hero-stats">
							<div>
								<span class="stat-value">6</span>
								<span class="stat-label">certificaciones</span>
							</div>
							<div>
								<span class="stat-value">Databricks</span>
								<span class="stat-label">Certified Professional</span>
							</div>
						</div>
					</div>
					<div class="hero-right">
						<img src="/images/yo.jpeg" alt="Daniel Eduardo" class="hero-avatar" loading="lazy" />
						<div class="hero-socials">
							<a class="hero-social" href="https://www.youtube.com/@DanielDatashow" target="_blank" rel="noreferrer">
								YouTube
							</a>
							<a class="hero-social" href="https://www.linkedin.com/in/danielportugalr/" target="_blank" rel="noreferrer">
								LinkedIn
							</a>
							<a class="hero-social" href="https://www.tiktok.com/@danielportugalr" target="_blank" rel="noreferrer">
								TikTok
							</a>
						</div>
					</div>
				</div>
			</section>

			<section class="about-section">
				<div class="section-inner">
					<span class="section-badge">Quién soy</span>
					<h2>Sobre mí</h2>
					<p>
						Soy Daniel Eduardo, Data Engineer y fundador de las comunidades Data Wizard y Data Engineering Latam.
						Mi recorrido está impulsado por la pasión de crear espacios donde las personas se conecten a través de la tecnología.
						Bajo mi marca, Daniel Datashow, creo contenido para desmitificar el mundo de los datos y transformar arquitecturas en
						insights accionables.
					</p>
					<p>
						Mi misión va más allá de los pipelines; estoy comprometido con mentorizar a quienes empiezan su camino. Como a mí me guiaron
						mentores, creo en compartir conocimiento y devolver a la comunidad. Busco empoderar a la próxima generación de profesionales
						de datos para que nadie recorra este camino en soledad.
					</p>
				</div>
			</section>

			<section class="projects-section">
				<div class="section-inner">
					<span class="section-badge gold">Contenido</span>
					<h2>Top contenido</h2>
					<p class="section-lead">Lo más destacado de la comunidad Daniel DataShow y Data Wizard.</p>
					<div class="project-grid">
						<article class="project-card">
							<h3>Daniel DataShow</h3>
							<p>Data engineering, aprendizajes y recursos prácticos.</p>
							<div class="project-embed">
								<iframe
									src="https://www.youtube.com/embed/edaWVN4gKWU"
									title="Daniel DataShow en YouTube"
									loading="lazy"
									referrerpolicy="no-referrer-when-downgrade"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
								></iframe>
							</div>
							<a class="pill" href="https://www.youtube.com/@DanielDatashow" target="_blank" rel="noreferrer">YouTube</a>
						</article>
						<article class="project-card">
							<h3>Podcast en Spotify</h3>
							<p>Podcast sobre arquitectura Lakehouse y AI en datos.</p>
							<div class="project-embed">
								<iframe
									src="https://open.spotify.com/embed/episode/4YXzuQGihWck7V71mGinkl?utm_source=generator"
									title="Podcast en Spotify"
									loading="lazy"
									allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
								></iframe>
							</div>
							<a
								class="pill"
								href="https://open.spotify.com/episode/4YXzuQGihWck7V71mGinkl?si=O7gqqiM8S-aL2wyRRrBY-A"
								target="_blank"
								rel="noreferrer"
							>
								Escuchar
							</a>
						</article>
						<article class="project-card">
							<h3>Data Wizard</h3>
							<p>Comunidad y contenidos para crecer en el mundo de los datos.</p>
							<div class="project-embed">
								<iframe
									src="https://www.youtube.com/embed/QKOg5JSRSlM"
									title="Data Wizard en YouTube"
									loading="lazy"
									referrerpolicy="no-referrer-when-downgrade"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
								></iframe>
							</div>
							<a class="pill" href="https://www.youtube.com/@DataWizardClub" target="_blank" rel="noreferrer">
								YouTube
							</a>
						</article>
					</div>
				</div>
			</section>

			<section class="credentials-section">
				<div class="section-inner">
					<span class="section-badge">Credenciales</span>
					<h2>Credenciales</h2>
					<p class="section-lead">Badges y certificaciones recientes.</p>
					<div class="credentials-grid">
						
						<img
							class="credential-badge"
							src={databricksProfessionalBadge.src}
							alt="Badge Databricks Professional"
							loading="lazy"
						/>
						<img
							class="credential-badge"
							src={databricksAssociateBadge.src}
							alt="Badge Databricks Associate"
							loading="lazy"
						/>
						<img
							class="credential-badge"
							src={databricksFundamentalsBadge.src}
							alt="Badge Databricks Fundamentals"
							loading="lazy"
						/>
						<img 
							class="credential-badge" 
							src={dbtBadge.src} 
							alt="Badge dbt" 
							loading="lazy" 
						/>
						<img 
							class="credential-badge" 
							src={astronomerBadge.src} 
							alt="Badge Astronomer" 
							loading="lazy" 
						/>
						<img
							class="credential-badge"
							src={awsCloudPractitionerBadge.src}
							alt="Badge AWS Certified Cloud Practitioner"
							loading="lazy"
						/>
					</div>
				</div>
			</section>

			<section class="linkedin-band">
				<div class="section-inner">
					<div class="linkedin-card">
						<img src="/images/yo.jpeg" alt="" loading="lazy" />
						<div>
							<h2>Hablemos en LinkedIn</h2>
							<p>Publico casos reales de datos e IA, novedades de Databricks y oportunidades en la comunidad. Sígueme o escríbeme por mensaje directo.</p>
						</div>
						<a class="btn-primary btn-linkedin" href="https://www.linkedin.com/in/danielportugalr/" target="_blank" rel="noreferrer">Seguir en LinkedIn</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
