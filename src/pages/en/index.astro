---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import EventsSection from '../../components/EventsSection.astro';
import '../../styles/home.css';
import { SITE_DESCRIPTION_EN, SITE_TITLE } from '../../consts';
import astronomerBadge from '../../assets/credentials/astronomer.png';
import awsCloudPractitionerBadge from '../../assets/credentials/aws-certified-cloud-practitioner.png';
import databricksAssociateBadge from '../../assets/credentials/databricks-associate.png';
import databricksFundamentalsBadge from '../../assets/credentials/databricks-fundamentals.png';
import databricksProfessionalBadge from '../../assets/credentials/databricks-professional.png';
import dbtBadge from '../../assets/credentials/dbt.png';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION_EN} />
	</head>
	<body class="home-page">
		<Header />
		<main>
			<section class="hero-section">
				<div class="hero-content">
					<div class="hero-left">
						<p class="hero-kicker"><span class="dot"></span>Data · AI · Community</p>
						<h1 class="hero-title">Daniel <span>DataShow</span></h1>
						<p class="hero-role">Field Engineering Leader at <b>Talento Para Ti</b> · Founder of <b>Data Wizard</b></p>
						<p class="hero-intro">I help companies and professionals get value from their data with Databricks, Spark and AI. I share what I learn in talks, videos and the Data Wizard community.</p>
						<div class="hero-actions">
							<a class="btn-primary btn-linkedin" href="https://www.linkedin.com/in/danielportugalr/" target="_blank" rel="noreferrer"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.475 0 16 .513 16 1.146v13.708c0 .633-.525 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.213c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.213V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/></svg>Connect on LinkedIn</a>
							<a class="btn-secondary" href="/en/presentaciones">See presentations <span aria-hidden="true">→</span></a>
						</div>
						<div class="hero-follow">
							<span>Follow me</span>
							<a href="https://www.youtube.com/@DanielDatashow" target="_blank" rel="noreferrer" aria-label="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M23.498 6.186a2.958 2.958 0 0 0-2.08-2.086C19.63 3.5 12 3.5 12 3.5s-7.63 0-9.418.6A2.958 2.958 0 0 0 .502 6.186C0 7.98 0 12 0 12s0 4.02.502 5.814a2.958 2.958 0 0 0 2.08 2.086C4.37 20.5 12 20.5 12 20.5s7.63 0 9.418-.6a2.958 2.958 0 0 0 2.08-2.086C24 16.02 24 12 24 12s0-4.02-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg></a>
							<a href="https://www.linkedin.com/in/danielportugalr/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.475 0 16 .513 16 1.146v13.708c0 .633-.525 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.213c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.213V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z"/></svg></a>
							<a href="https://www.tiktok.com/@danielportugalr" target="_blank" rel="noreferrer" aria-label="TikTok"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg></a>
							<a href="http://github.com/DanielEdu" target="_blank" rel="noreferrer" aria-label="GitHub"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a>
						</div>
					</div>
					<div class="hero-right">
						<div class="hero-photo">
							<img src="/images/daniel-portrait.webp" alt="Daniel Portugal" width="1200" height="1200" />
							<div class="hero-chip chip-top"><img src={databricksProfessionalBadge.src} alt="" /><div><b>Databricks Certified</b><span>Professional</span></div></div>
							<div class="hero-chip chip-bottom"><b>6 certifications</b><span>Databricks · dbt · AWS · Airflow</span></div>
						</div>
					</div>
				</div>
			</section>

			<EventsSection lang="en" />

			<section class="about-section">
				<div class="section-inner">
					<span class="section-badge">Who I am</span>
					<h2>About me</h2>
					<p>
						I’m Daniel Eduardo, Data Engineer and founder of the Data Wizard and Data Engineering Latam communities. 
						My journey is driven by a passion for building spaces where people connect through technology. 
						Under my brand, Daniel Datashow, I create content to demystify the data world, transforming architectures into 
						actionable insights.
					</p>
					<p>
						My mission goes beyond pipelines; I am committed to mentoring those starting their journey. Because mentors once guided me, 
						I believe in sharing knowledge and giving back to the community. 
						I strive to empower the next generation of data professionals, ensuring no one has to walk the path toward mastery alone.
					</p>
				</div>
			</section>

			<section class="projects-section">
				<div class="section-inner">
					<span class="section-badge gold">Content</span>
					<h2>Featured content</h2>
					<p class="section-lead">Highlights from the Daniel DataShow and Data Wizard community.</p>
					<div class="project-grid">
						<article class="project-card">
							<h3>Daniel DataShow</h3>
							<p>Data engineering insights, lessons learned, and practical resources.</p>
							<div class="project-embed">
								<iframe
									src="https://www.youtube.com/embed/edaWVN4gKWU"
									title="Daniel DataShow en YouTube"
									loading="lazy"
									referrerpolicy="no-referrer-when-downgrade"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
								></iframe>
							</div>
							<a class="pill" href="https://www.youtube.com/@DanielDatashow" target="_blank" rel="noreferrer">YouTube</a>
						</article>
						<article class="project-card">
							<h3>Spotify podcast</h3>
							<p>Conversations on Lakehouse architecture and AI in data.</p>
							<div class="project-embed">
								<iframe
									src="https://open.spotify.com/embed/episode/4YXzuQGihWck7V71mGinkl?utm_source=generator"
									title="Podcast en Spotify"
									loading="lazy"
									allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
								></iframe>
							</div>
							<a
								class="pill"
								href="https://open.spotify.com/episode/4YXzuQGihWck7V71mGinkl?si=O7gqqiM8S-aL2wyRRrBY-A"
								target="_blank"
								rel="noreferrer"
							>
								Listen
							</a>
						</article>
						<article class="project-card">
							<h3>Data Wizard</h3>
							<p>Community and content to grow in the data world.</p>
							<div class="project-embed">
								<iframe
									src="https://www.youtube.com/embed/QKOg5JSRSlM"
									title="Data Wizard en YouTube"
									loading="lazy"
									referrerpolicy="no-referrer-when-downgrade"
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
									allowfullscreen
								></iframe>
							</div>
							<a class="pill" href="https://www.youtube.com/@DataWizardClub" target="_blank" rel="noreferrer">
								YouTube
							</a>
						</article>
					</div>
				</div>
			</section>

			<section class="credentials-section">
				<div class="section-inner">
					<span class="section-badge">Credentials</span>
					<h2>Credentials</h2>
					<p class="section-lead">Recent badges and certifications.</p>
					<div class="credentials-grid">
						
						<img
							class="credential-badge"
							src={databricksProfessionalBadge.src}
							alt="Badge Databricks Professional"
							loading="lazy"
						/>
						<img
							class="credential-badge"
							src={databricksAssociateBadge.src}
							alt="Badge Databricks Associate"
							loading="lazy"
						/>
						<img
							class="credential-badge"
							src={databricksFundamentalsBadge.src}
							alt="Badge Databricks Fundamentals"
							loading="lazy"
						/>
						<img 
							class="credential-badge" 
							src={dbtBadge.src} 
							alt="Badge dbt" 
							loading="lazy" 
						/>
						<img 
							class="credential-badge" 
							src={astronomerBadge.src} 
							alt="Badge Astronomer" 
							loading="lazy" 
						/>
						<img
							class="credential-badge"
							src={awsCloudPractitionerBadge.src}
							alt="Badge AWS Certified Cloud Practitioner"
							loading="lazy"
						/>
					</div>
				</div>
			</section>

			<section class="linkedin-band">
				<div class="section-inner">
					<div class="linkedin-card">
						<img src="/images/yo.jpeg" alt="" loading="lazy" />
						<div>
							<h2>Let's talk on LinkedIn</h2>
							<p>I post real data & AI cases, Databricks news and community opportunities. Follow me or send me a direct message.</p>
						</div>
						<a class="btn-primary btn-linkedin" href="https://www.linkedin.com/in/danielportugalr/" target="_blank" rel="noreferrer">Follow on LinkedIn</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
