---
const today = new Date();
const pathname = Astro.url.pathname;
const isEn = pathname.startsWith('/en');
const copy = isEn
	? `All rights reserved.`
	: `Todos los derechos reservados.`;

const socials = [
	{
		label: 'YouTube',
		href: 'https://www.youtube.com/@DanielDatashow',
		color: '#ff4d4d',
		path: 'M23.498 6.186a2.958 2.958 0 0 0-2.08-2.086C19.63 3.5 12 3.5 12 3.5s-7.63 0-9.418.6A2.958 2.958 0 0 0 .502 6.186C0 7.98 0 12 0 12s0 4.02.502 5.814a2.958 2.958 0 0 0 2.08 2.086C4.37 20.5 12 20.5 12 20.5s7.63 0 9.418-.6a2.958 2.958 0 0 0 2.08-2.086C24 16.02 24 12 24 12s0-4.02-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
		viewBox: '0 0 24 24',
	},
	{
		label: 'LinkedIn',
		href: 'https://www.linkedin.com/in/danielportugalr/',
		color: '#00a3ff',
		path: 'M0 1.146C0 .513.526 0 1.175 0h13.65C15.475 0 16 .513 16 1.146v13.708c0 .633-.525 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.213c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.213V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z',
		viewBox: '0 0 16 16',
	},
	{
		label: 'TikTok',
		href: 'https://www.tiktok.com/@danielportugalr',
		color: '#f4b942',
		path: 'M12.53.02C13.84 0 15.14.01 16.44 0c.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z',
		viewBox: '0 0 24 24',
	},
	{
		label: 'GitHub',
		href: 'http://github.com/DanielEdu',
		color: '#e2e8f0',
		path: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z',
		viewBox: '0 0 16 16',
	},
];
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<p class="footer-logo">Daniel <span class="brand-accent">DataShow</span></p>
			<p class="footer-tagline">Data Engineering · Mentoring · Data Wizard</p>
		</div>

		<div class="social-links">
			{
				socials.map((s) => (
					<a href={s.href} target="_blank" rel="noreferrer">
						<svg viewBox={s.viewBox} aria-hidden="true" style={{ color: s.color }}
							><path fill="currentColor" d={s.path} /></svg
						>
						{s.label}
					</a>
				))
			}
		</div>

		<div class="footer-bottom">
			&copy; {today.getFullYear()} Daniel Eduardo Portugal Revilla. {copy}
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 3.5em 1.5em 6em;
		background: var(--navy);
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		color: rgb(var(--gray));
	}
	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
	}
	.footer-brand {
		text-align: center;
		margin-bottom: 2rem;
	}
	.footer-logo {
		font-family: "Inter", "Atkinson", sans-serif;
		font-weight: 800;
		font-size: 1.2rem;
		color: #f8fafc;
		margin: 0 0 0.3rem;
	}
	.brand-accent {
		color: var(--accent);
	}
	.footer-tagline {
		margin: 0;
		font-size: 0.9rem;
		color: #64748b;
	}
	.social-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.75rem;
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 1.1rem;
		border-radius: 12px;
		border: 1px solid rgba(255, 255, 255, 0.08);
		background: rgba(255, 255, 255, 0.03);
		text-decoration: none;
		color: #94a3b8;
		font-weight: 600;
		font-size: 0.9rem;
		font-family: "Inter", "Atkinson", sans-serif;
		transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
	}
	.social-links a svg {
		width: 16px;
		height: 16px;
	}
	.social-links a:hover {
		color: #f8fafc;
		border-color: rgba(0, 163, 255, 0.35);
		background: rgba(0, 163, 255, 0.08);
	}
	.footer-bottom {
		margin-top: 2.5rem;
		padding-top: 1.75rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		text-align: center;
		font-size: 0.8rem;
		color: #64748b;
	}
</style>
